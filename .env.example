# ==============================================================================
# Environment Configuration - Smart Commerce Platform (Price Comparator)
# ==============================================================================

ENVIRONMENT=development
DEBUG=True

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=price_comparator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/price_comparator

# JWT - replace SECRET_KEY before any non-local deployment
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local seed accounts (development only)
SEED_ON_STARTUP=false
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_SHOPKEEPER_EMAIL=shopkeeper@local.dev
SEED_SHOPKEEPER_PASSWORD=ShopPass123!
SEED_CUSTOMER_EMAIL=customer@local.dev
SEED_CUSTOMER_PASSWORD=CustPass123!

# Future permitted retailer APIs / affiliate feeds (do not scrape)
# RETAILER_A_API_KEY=
# RETAILER_B_API_KEY=
