# ==============================================================================
# Environment Configuration - Smart Commerce Platform (Price Comparator)
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Frontend Service
VITE_API_BASE_URL=http://localhost:8000/api

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=price_comparator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/price_comparator

# External Retailer Feed & API Configurations (Placeholders for future permitted APIs)
# RETAILER_A_API_KEY=your_key_here
# RETAILER_B_API_KEY=your_key_here
